<?xml version="1.0" encoding="utf-8"?>
<policyDefinitions revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces><target prefix="mrng" namespace="mRemoteNG.Policies.Security" /></policyNamespaces>
  <resources minRequiredRevision="1.0" />
  <supportedOn><definitions><definition name="SecurityPolicyBuild" displayName="$(string.Supported)" /></definitions></supportedOn>
  <categories>
    <category name="mRemoteNG" displayName="$(string.Product)" />
    <category name="Security" displayName="$(string.Security)"><parentCategory ref="mRemoteNG" /></category>
  </categories>
  <policies>
    <policy name="RequireMasterPassword" class="Machine" displayName="$(string.RequireMasterPassword)" explainText="$(string.RequireMasterPassword_Help)" key="SOFTWARE\Policies\mRemoteNG\Security" valueName="RequireMasterPassword">
      <parentCategory ref="Security" />
      <supportedOn ref="SecurityPolicyBuild" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="AllowPersistentUnlock" class="Machine" displayName="$(string.AllowPersistentUnlock)" explainText="$(string.AllowPersistentUnlock_Help)" key="SOFTWARE\Policies\mRemoteNG\Security" valueName="AllowPersistentUnlock">
      <parentCategory ref="Security" />
      <supportedOn ref="SecurityPolicyBuild" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="MinimumMasterPasswordLength" class="Machine" displayName="$(string.MinimumMasterPasswordLength)" explainText="$(string.MinimumMasterPasswordLength_Help)" key="SOFTWARE\Policies\mRemoteNG\Security" presentation="$(presentation.MinimumMasterPasswordLength)">
      <parentCategory ref="Security" />
      <supportedOn ref="SecurityPolicyBuild" />
      <elements><decimal id="MinimumMasterPasswordLength" valueName="MinimumMasterPasswordLength" minValue="1" maxValue="1024" required="true" /></elements>
    </policy>
    <policy name="RequireUppercase" class="Machine" displayName="$(string.RequireUppercase)" explainText="$(string.RequireUppercase_Help)" key="SOFTWARE\Policies\mRemoteNG\Security" valueName="RequireUppercase">
      <parentCategory ref="Security" />
      <supportedOn ref="SecurityPolicyBuild" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="RequireLowercase" class="Machine" displayName="$(string.RequireLowercase)" explainText="$(string.RequireLowercase_Help)" key="SOFTWARE\Policies\mRemoteNG\Security" valueName="RequireLowercase">
      <parentCategory ref="Security" />
      <supportedOn ref="SecurityPolicyBuild" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="RequireDigit" class="Machine" displayName="$(string.RequireDigit)" explainText="$(string.RequireDigit_Help)" key="SOFTWARE\Policies\mRemoteNG\Security" valueName="RequireDigit">
      <parentCategory ref="Security" />
      <supportedOn ref="SecurityPolicyBuild" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="RequireSpecialCharacter" class="Machine" displayName="$(string.RequireSpecialCharacter)" explainText="$(string.RequireSpecialCharacter_Help)" key="SOFTWARE\Policies\mRemoteNG\Security" valueName="RequireSpecialCharacter">
      <parentCategory ref="Security" />
      <supportedOn ref="SecurityPolicyBuild" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="RequireFullEncryption" class="Machine" displayName="$(string.RequireFullEncryption)" explainText="$(string.RequireFullEncryption_Help)" key="SOFTWARE\Policies\mRemoteNG\Security" valueName="RequireFullEncryption">
      <parentCategory ref="Security" />
      <supportedOn ref="SecurityPolicyBuild" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="AllowPasswordExport" class="Machine" displayName="$(string.AllowPasswordExport)" explainText="$(string.AllowPasswordExport_Help)" key="SOFTWARE\Policies\mRemoteNG\Security" valueName="AllowPasswordExport">
      <parentCategory ref="Security" />
      <supportedOn ref="SecurityPolicyBuild" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="AllowPlaintextExport" class="Machine" displayName="$(string.AllowPlaintextExport)" explainText="$(string.AllowPlaintextExport_Help)" key="SOFTWARE\Policies\mRemoteNG\Security" valueName="AllowPlaintextExport">
      <parentCategory ref="Security" />
      <supportedOn ref="SecurityPolicyBuild" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>
    <policy name="EncryptionEngine" class="Machine" displayName="$(string.EncryptionEngine)" explainText="$(string.EncryptionEngine_Help)" key="SOFTWARE\Policies\mRemoteNG\Security" presentation="$(presentation.EncryptionEngine)">
      <parentCategory ref="Security" />
      <supportedOn ref="SecurityPolicyBuild" />
      <elements><enum id="EncryptionEngine" valueName="EncryptionEngine" required="true">
        <item displayName="$(string.AES)"><value><string>AES</string></value></item>
        <item displayName="$(string.Serpent)"><value><string>Serpent</string></value></item>
        <item displayName="$(string.Twofish)"><value><string>Twofish</string></value></item>
      </enum></elements>
    </policy>
    <policy name="BlockCipherMode" class="Machine" displayName="$(string.BlockCipherMode)" explainText="$(string.BlockCipherMode_Help)" key="SOFTWARE\Policies\mRemoteNG\Security" presentation="$(presentation.BlockCipherMode)">
      <parentCategory ref="Security" />
      <supportedOn ref="SecurityPolicyBuild" />
      <elements><enum id="BlockCipherMode" valueName="BlockCipherMode" required="true">
        <item displayName="$(string.GCM)"><value><string>GCM</string></value></item>
        <item displayName="$(string.EAX)"><value><string>EAX</string></value></item>
        <item displayName="$(string.CCM)"><value><string>CCM</string></value></item>
      </enum></elements>
    </policy>
    <policy name="MinimumKdfIterations" class="Machine" displayName="$(string.MinimumKdfIterations)" explainText="$(string.MinimumKdfIterations_Help)" key="SOFTWARE\Policies\mRemoteNG\Security" presentation="$(presentation.MinimumKdfIterations)">
      <parentCategory ref="Security" />
      <supportedOn ref="SecurityPolicyBuild" />
      <elements><decimal id="MinimumKdfIterations" valueName="MinimumKdfIterations" minValue="1000" maxValue="10000000" required="true" /></elements>
    </policy>
  </policies>
</policyDefinitions>
